rule "Private key block in a user message"
metadata:
    description = "A user message carries a PEM private key header (RSA, EC, OpenSSH, DSA, PGP or PKCS#8)."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "dlp-private-key"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----" regex
condition:
    any msg in user_messages where msg.content contains $p
