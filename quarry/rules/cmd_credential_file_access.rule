rule "Credential file read in a command"
metadata:
    description = "A command reads a credential store: AWS credentials, an SSH private key, .git-credentials, the macOS keychain, a gcloud access token, the environment filtered for secrets, a browser credential or cookie store, or shell history searched for secrets."
    severity = "high"
    atlas = "AML.T0098"
    moorai_threat = "55"
    moorai_detector = "cred-file-access"
    surface = "tool_calls"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = [
        "[~\/][^\s\"']*\.aws[\/\\]credentials\b",
        "\.ssh[\/\\]id_(rsa|ed25519|ecdsa|dsa)\b",
        "\.git-credentials\b",
        "\bsecurity\s+find-generic-password\b",
        "\bgcloud\s+auth\s+(print-access-token|application-default\s+print-access-token)\b",
        "\b(printenv|env)\b[^\n]{0,20}\|\s*grep\s+-i[^\n]{0,20}\b(secret|token|key|password|aws)\b",
        "(?:Google[\/\\]Chrome|Chromium|BraveSoftware|Microsoft[\/\\ ]Edge|Vivaldi|Opera Software|Mozilla[\/\\]Firefox|Firefox[\/\\]Profiles)[\/\\][^\n\"']{0,160}?(?:Login Data|Web Data|Cookies|Local State|key4\.db|logins\.json|cookies\.sqlite|signons\.sqlite)\b",
        "\bsecurity\s+dump-keychain\b",
        "\bgrep\b[^\n|]{0,40}?-i[^\n|]{0,40}?(?:password|passwd|secret|token|api[_-]?key|aws)[^\n]{0,60}?(?:\.bash_history|\.zsh_history|\.sh_history)\b",
        "(?:\.bash_history|\.zsh_history|\.sh_history)\b[^\n]{0,40}?\|\s*grep\b[^\n]{0,60}?(?:password|passwd|secret|token|api[_-]?key|aws)"
    ] nocase regex
condition:
    any call in tool_calls where call.arguments.command contains $p
