rule "AWS access key ID in a user message"
metadata:
    description = "A user message carries an AWS access key ID (AKIA or ASIA prefix). Shape only: MoorAI checks no checksum here either."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-aws-akia"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "\b(AKIA|ASIA)[A-Z0-9]{16}\b" regex
condition:
    any msg in user_messages where msg.content contains $p
