rule "GitHub token in a user message"
metadata:
    description = "A user message carries a GitHub personal access, OAuth, user-to-server, server-to-server or refresh token, or a fine-grained PAT."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-github"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = [
        "\bgh[posru]_[A-Za-z0-9]{36,}\b",
        "\bgithub_pat_[A-Za-z0-9_]{22,}\b"
    ] regex
condition:
    any msg in user_messages where msg.content contains $p
