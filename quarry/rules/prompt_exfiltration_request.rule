rule "Request to send data out"
metadata:
    description = "A user message asks the model to exfiltrate data, send data or files out or to a destination, or post it to a URL."
    severity = "critical"
    atlas = "AML.T0051,AML.T0054"
    moorai_threat = "2"
    moorai_detector = "inj-exfil"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "\b(exfiltrate|send (the )?(data|info|information|file)s? (out|to)|post (it )?to https?:)" nocase regex
condition:
    any msg in user_messages where msg.content contains $p
