rule "Credential in a tool result"
metadata:
    description = "A tool result carries a provider credential the agent would read into its context: an AWS key ID, GitHub, Google, sk- or Slack token, a JWT or bearer value, or a private key header. The same patterns MoorAI applies on the output stage."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-aws-akia,secret-github,secret-google-api,secret-openai-anthropic,secret-slack,dlp-jwt,dlp-private-key"
    surface = "tool_responses"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = [
        "\b(AKIA|ASIA)[A-Z0-9]{16}\b",
        "\bgh[posru]_[A-Za-z0-9]{36,}\b",
        "\bgithub_pat_[A-Za-z0-9_]{22,}\b",
        "\bAIza[A-Za-z0-9\-_]{35}\b",
        "\bsk-(ant-|proj-)?[A-Za-z0-9\-_]{20,}\b",
        "\bxox[baprs]-[A-Za-z0-9-]{10,}\b",
        "\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}\b",
        "\b[Bb][Ee][Aa][Rr][Ee][Rr]\s+[A-Za-z0-9._-]{20,}",
        "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"
    ] regex
condition:
    any r in tool_responses where r.content contains $p
