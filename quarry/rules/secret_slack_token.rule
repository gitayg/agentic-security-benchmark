rule "Slack token in a user message"
metadata:
    description = "A user message carries a Slack bot, app, user, refresh or legacy token (xoxb-, xoxa-, xoxp-, xoxr-, xoxs-)."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-slack"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "\bxox[baprs]-[A-Za-z0-9-]{10,}\b" regex
condition:
    any msg in user_messages where msg.content contains $p
