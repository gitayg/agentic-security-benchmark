rule "OpenAI or Anthropic API key in a user message"
metadata:
    description = "A user message carries an sk- API key (OpenAI, OpenAI project or Anthropic shape). Shape only, and the sk- prefix is shared by other providers."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-openai-anthropic"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "\bsk-(ant-|proj-)?[A-Za-z0-9\-_]{20,}\b" regex
condition:
    any msg in user_messages where msg.content contains $p
