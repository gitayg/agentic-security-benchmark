rule "Google API key in a user message"
metadata:
    description = "A user message carries a Google API key (AIza prefix, 39 characters)."
    severity = "critical"
    atlas = "AML.T0057"
    moorai_threat = "39"
    moorai_detector = "secret-google-api"
    moorai_mode = "warn"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = "\bAIza[A-Za-z0-9\-_]{35}\b" regex
condition:
    any msg in user_messages where msg.content contains $p
