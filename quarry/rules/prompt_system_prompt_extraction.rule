rule "System prompt extraction request"
metadata:
    description = "A user message asks the model to repeat, print or reveal its system prompt, initial instructions or rules."
    severity = "medium"
    atlas = "AML.T0056"
    moorai_threat = "51"
    moorai_detector = "sysprompt-extract"
    surface = "user_messages"
    source = "MoorAI agent v1.43.0 (MIT), data/detectors.js; relicensed Apache-2.0 by its copyright holder"
strings:
    $p = [
        "\b(repeat|print|show|reveal|output|display|give me|tell me)\b[^.\n]{0,40}\b(the\s+)?(system|initial|developer|above|previous|your)\s+(prompt|instructions?|message|rules?|directives?)\b",
        "\b(what|which)\s+(are|were)\s+your\s+(instructions?|rules?|system\s+prompt|directives?|guidelines?)\b",
        "\brepeat (the words|everything) above\b"
    ] nocase regex
condition:
    any msg in user_messages where msg.content contains $p
